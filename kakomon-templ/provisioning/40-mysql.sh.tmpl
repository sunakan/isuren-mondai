#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "${SCRIPT_DIR}/lib.sh"

# Install the common server package without adding target DB users, schema, or
# initial data. Those identities remain in target-owned steps.
install_mysql() {
  if ! dpkg -s mysql-server >/dev/null 2>&1; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y mysql-server
    log "mysql-server: installed"
  else
    log "mysql-server: already installed"
  fi
}

start_mysql_service() {
  systemctl enable --now mysql
  mysqladmin --defaults-file=/dev/null --user=root ping
  log "mysql service: enabled, started, and ready"
}

install_mysql
start_mysql_service

log "40-mysql.sh: done"
