#!/usr/bin/env bash
#MISE description="kakomon14/packerでpacker buildを実行(cloud-initでisucon14(Go)をプロビジョニング)"
set -euo pipefail
VPC_ID="$(aws cloudformation describe-stacks \
  --stack-name "$PACKER_NETWORK_STACK_NAME" \
  --query "Stacks[0].Outputs[?OutputKey=='VpcId'].OutputValue" --output text)"
SUBNET_ID="$(aws cloudformation describe-stacks \
  --stack-name "$PACKER_NETWORK_STACK_NAME" \
  --query "Stacks[0].Outputs[?OutputKey=='SubnetId'].OutputValue" --output text)"
IAM_INSTANCE_PROFILE="$(aws cloudformation describe-stacks \
  --stack-name "$PACKER_NETWORK_STACK_NAME" \
  --query "Stacks[0].Outputs[?OutputKey=='PackerInstanceProfileName'].OutputValue" --output text)"

# shellcheck source=scripts/lib.sh
source scripts/lib.sh
# user-data.yamlはHEADのcommit SHAをgit clone対象として埋め込む。未コミット・未pushだと
# EC2起動時のgit fetchが失敗し、Packerビルドの奥深くで分かりにくく落ちるため事前に検知する。
require_clean_worktree
PROJECT_COMMIT="$(git rev-parse HEAD)"
export PROJECT_COMMIT
require_pushed_commit "${PROJECT_COMMIT}"

# AMIタグ(Base)用。50-source.shのISUCON14_COMMIT(取り込み元isucon/isucon14のコミット)を
# デフォルト値定義行から抽出する(この値を上書きしている箇所はリポジトリ内に無い)。
ISUCON14_COMMIT="$(sed -nE 's/.*ISUCON14_COMMIT:=([0-9a-f]+).*/\1/p' kakomon14/provisioning/50-source.sh)"
# 50-source.sh側の変数定義の書き方が変わってsedのパターンにマッチしなくなると空文字になり、
# Baseタグが壊れた値のままビルドが成功してしまう(気づけない)ため、抽出結果を検証する。
if [ -z "${ISUCON14_COMMIT}" ]; then
  echo "エラー: kakomon14/provisioning/50-source.shからISUCON14_COMMITを抽出できませんでした。" >&2
  exit 1
fi

# user-data.yamlはprovisioning/配下から再生成可能なためgit管理していない。
# ビルドのたびに最新化することで、生成し忘れによる古いuser-dataでのビルドを防ぐ。
python3 kakomon14/cloud-init/generate-user-data.py
cd kakomon14/packer
# ビルドログを画面に出しつつファイルにも残す(AMI ID抽出のため)。pipefailにより
# packer build自体の終了コードが失われない。
BUILD_LOG="$(mktemp)"
trap 'rm -f "$BUILD_LOG" frontend-release-tag.txt' EXIT
packer build \
  -var "vpc_id=$VPC_ID" \
  -var "subnet_id=$SUBNET_ID" \
  -var "iam_instance_profile=$IAM_INSTANCE_PROFILE" \
  -var "project_url=https://github.com/sunakan/isuren-mondai/commit/${PROJECT_COMMIT}" \
  -var "base_url=https://github.com/isucon/isucon14/commit/${ISUCON14_COMMIT}" \
  empty.pkr.hcl | tee "$BUILD_LOG"
AMI_ID="$(grep -oE 'ami-[0-9a-f]+' "$BUILD_LOG" | tail -n1)"

# 80-frontend.sh(FRONTEND_RELEASE_TAG=latest)がPacker側へ渡した、実際に焼き込まれた
# frontendの具体的なタグ。latestだとディスク中身だけでは追跡できないため、AMIタグに残す。
RESOLVED_TAG="$(cat frontend-release-tag.txt)"
aws ec2 create-tags --resources "$AMI_ID" \
  --tags "Key=Frontend,Value=https://github.com/sunakan/isuren-mondai/releases/tag/${RESOLVED_TAG}"
echo "AMI tagged: Frontend=${RESOLVED_TAG}"
