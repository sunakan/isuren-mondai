#!/usr/bin/env bash
#MISE description="official mirrorとmanaged sourceの差分を表示 (kakomon14独自: Go/SQLを比較)"
set -euo pipefail

# The official mirror is read-only evidence; diff exit 1 means differences,
# not a task failure.
mirror=tmp/all-kakomon/isucon14
test -d "${mirror}/.git" || {
  echo "error: worktree-local mirror is missing; run kakomon14:refresh-upstream first" >&2
  exit 1
}
test "$(git -C "${mirror}" remote get-url origin)" = "https://github.com/isucon/isucon14.git"
test -z "$(git -C "${mirror}" status --short)"

# kakomon14独自: the managed source comparison is limited to Go and SQL;
# frontend/public and other non-managed data follow NOTICE.md instead.
diff -ru "${mirror}/webapp/go" upstream/isucon14/webapp/go || true
diff -ru "${mirror}/webapp/sql" upstream/isucon14/webapp/sql || true
