#!/usr/bin/env bash
#MISE description="frontendのdist出力をGitHub Releaseへuploadする (kakomon14独自: archive/frontend manifestを公開)"
set -euo pipefail

TAG="${1:?タグ名を指定してください(例: mise run kakomon14:release kakomon14-frontend-v1.0.0)}"
[[ "${TAG}" =~ ^kakomon14-frontend-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "error: tag must be kakomon14-frontend-vMAJOR.MINOR.PATCH" >&2
  exit 1
}
# shellcheck source=scripts/lib.sh
source scripts/lib.sh
require_clean_worktree
require_pushed_commit "$(git rev-parse HEAD)"
require_tag_absent_or_at_head "${TAG}"

# Keep the release token out of the frontend build. Restore it only for the
# GitHub Release upload process.
release_gh_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
export -n release_gh_token
unset GH_TOKEN GITHUB_TOKEN
# kakomon14独自: publish the archive and frontend hash/file manifests.
mise run kakomon14:build-frontend
GH_TOKEN="${release_gh_token}" scripts/github-release.sh "${TAG}" \
  kakomon14/dist/kakomon14-frontend.tar.gz \
  kakomon14/dist/frontend_hashes.json \
  kakomon14/dist/frontend_files.json
unset release_gh_token
