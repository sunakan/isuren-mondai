#!/usr/bin/env bash
#MISE description="frontendのdist出力をGitHub Releaseへuploadする (引数: exact tag)"
set -euo pipefail

TAG="${1:?タグ名を指定してください(例: mise run kakomon13:release kakomon13-frontend-v1.0.0)}"
[[ "${TAG}" =~ ^kakomon13-frontend-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "error: tag must be kakomon13-frontend-vMAJOR.MINOR.PATCH" >&2
  exit 1
}
# shellcheck source=scripts/lib.sh
source scripts/lib.sh
require_clean_worktree
require_pushed_commit "$(git rev-parse HEAD)"
require_tag_absent_or_at_head "${TAG}"

# Keep the release token out of the frontend build. Restore it only for the
# GitHub Release upload process.
release_gh_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
export -n release_gh_token
unset GH_TOKEN GITHUB_TOKEN
# kakomon13独自: publish the archive, archive checksum, and frontend manifest.
mise run kakomon13:build-frontend
GH_TOKEN="${release_gh_token}" scripts/github-release.sh "${TAG}" \
  kakomon13/dist/kakomon13-frontend.tar.gz \
  kakomon13/dist/kakomon13-frontend.tar.gz.sha256 \
  kakomon13/dist/frontend.manifest.sha256
unset release_gh_token
