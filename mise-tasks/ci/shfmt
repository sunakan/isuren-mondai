#!/usr/bin/env bash
#MISE description="shellスクリプトをshfmtでフォーマットチェック(取り込んだ本家コードのupstream/配下、参照用clone置き場のtmp/配下は対象外)"
set -euo pipefail
# mise-tasks/配下は拡張子なしのbashスクリプトなので、*.shだけでなくパスでも対象に含める。
# -i 2: shfmtのデフォルトインデントはタブのため、このリポジトリの2スペースインデントに対して
# 指定なしだと常にタブへの変換を提案してくる(誤検知)。
find . \( -name '*.sh' -o -path './mise-tasks/*' \) -type f -not -path '*/upstream/*' -not -path '*/tmp/*' -print0 | xargs -0 shfmt -i 2 -d
