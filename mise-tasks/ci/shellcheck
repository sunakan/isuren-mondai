#!/usr/bin/env bash
#MISE description="shellスクリプトをshellcheckで検査(取り込んだ本家コードのupstream/配下、参照用clone置き場のtmp/配下は対象外)"
set -euo pipefail
# mise-tasks/配下は拡張子なしのbashスクリプトなので、*.shだけでなく実行可能なfile taskを
# 対象に含める。READMEやcopy用の非実行*.tmplは各template taskの検証へ委ねる。
# -x -P SCRIPTDIR: 各スクリプトが持つsource=./lib.sh形式のディレクティブを、実行時のcwdではなく
# ファイル自身のディレクトリ基準で解決させる(これが無いとlib.shが見つからずSC1091が常に出る)。
scripts=()
while IFS= read -r -d '' script; do
  if [[ "${script}" == ./mise-tasks/* && ! -x "${script}" ]]; then
    continue
  fi
  scripts+=("${script}")
done < <(find . \( -name '*.sh' -o -path './mise-tasks/*' \) -type f \
  -not -path '*/upstream/*' -not -path '*/tmp/*' -print0)

shellcheck -x -P SCRIPTDIR "${scripts[@]}"
