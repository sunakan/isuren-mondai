[Unit]
Description=kakomon10-qualify Go Application
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=isuren
Group=isuren
WorkingDirectory=/home/isuren/isuumo/webapp/go
EnvironmentFile=/home/isuren/env.sh
ExecStart=/home/isuren/isuumo/webapp/go/isuumo
Restart=on-failure
RestartSec=2s
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
