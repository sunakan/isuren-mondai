KAKOMON10_QUALIFY_SOURCE_AMI_OWNER=099720109477
KAKOMON10_QUALIFY_ROOT_VOLUME_GIB=8
KAKOMON10_QUALIFY_PACKER_NETWORK_STACK_NAME=isuren-mondai-packer-network
