[Unit]
Description=isuride-payment_mock
After=syslog.target

[Service]
WorkingDirectory=/home/isuren/webapp/payment_mock

User=isuren
Group=isuren
ExecStart=/home/isuren/webapp/payment_mock/payment_mock
ExecStop=/bin/kill -s QUIT $MAINPID

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
