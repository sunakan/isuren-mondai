[Unit]
Description=isuride-go
After=syslog.target
After=mysql.service
Requires=mysql.service

[Service]
WorkingDirectory=/home/isuren/webapp/go
EnvironmentFile=/home/isuren/env.sh

User=isuren
Group=isuren
ExecStart=/home/isuren/webapp/go/isuride
ExecStop=/bin/kill -s QUIT $MAINPID

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
