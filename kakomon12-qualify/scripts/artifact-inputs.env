# initial_data is distributed only as a GitHub Release asset (bench/Makefile's
# `gh release list | awk '/Latest/{print $3}' | xargs gh release download`),
# never as a Git blob. Resolving the exact tag/asset/digest requires network
# access to the official repository's Releases, which is out of scope for the
# audit/plan/implement modes of onboard-kakomon-ami-recipe (read-only, no
# external operations). This placeholder intentionally fails the regex check
# in 05-artifacts.sh until a human resolves it during the `verify` mode
# external-operation preflight (see kakomon12-qualify/README.md).
INITIAL_DATA_RELEASE_TAG=REQUIRES_VERIFY_PHASE_RESOLUTION
INITIAL_DATA_ASSET_NAME=REQUIRES_VERIFY_PHASE_RESOLUTION
INITIAL_DATA_SHA256=REQUIRES_VERIFY_PHASE_RESOLUTION
